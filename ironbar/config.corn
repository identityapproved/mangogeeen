// Single Ironbar (top) for mango — all modules consolidated here (Waybar disabled).
// Tags are clickable per-tag buttons driven by scripts/mango-ipc.py (live active
// highlight) + `mmsg dispatch view` on click. Title/layout/cava use watch feeds.
let {
    $music = {
        type = "music"
        player_type = "mpd"
        format = "{title} - {artist}"
        truncate.mode = "end"
        truncate.max_length = 35
        icons.play = "󰐊 "
        icons.pause = "󰏤 "
        icons.prev = "󰒮"
        icons.next = "󰒭"
    }

    $title = {
        type = "custom"
        bar = [
            {
                type = "label"
                name = "title"
                class = "title"
                label = "󱝳 {{watch:~/.config/scripts/mango-ipc.py title --max 60}}"
            }
        ]
    }

    $cava = {
        type = "script"
        mode = "watch"
        name = "cava"
        cmd = "~/.config/ironbar/scripts/cava"
    }

    $cpu = { type = "sys_info" interval.cpu = 2  format = [ "󰻠 {cpu_percent}%" ] }
    $mem = { type = "sys_info" interval.memory = 5 format = [ "󰍛 {memory_percent}%" ] }
    $disk = { type = "sys_info" interval.disks = 60 format = [ "󰋊 {disk_percent@/}%" ] }

    $network = {
        type = "custom"
        bar = [
            {
                type = "label"
                name = "network"
                class = "network"
                label = "󰈀 {{30000:ip -br address | awk '$2==\"UP\"{print $1; exit}'}}"
            }
        ]
    }

    $keyboard = {
        type = "script"
        mode = "watch"
        name = "keyboard"
        cmd = "~/.config/scripts/mango-ipc.py layout"
    }

    $volume = {
        type = "volume"
        format = "{icon} {percentage}%"
        max_volume = 100
        icons.volume_high = "󰕾 "
        icons.volume_medium = "󰖀"
        icons.volume_low = "󰕿"
        icons.muted = "󰝟 "
        on_scroll_up = "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%+"
        on_scroll_down = "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-"
    }

    $clock = { type = "clock" format = "%a %b %d  %H:%M" }
    $tray = { type = "tray" }

    $wlogout = {
        type = "custom"
        bar = [
            { type = "button" name = "wlogout" class = "wlogout" label = "󰐥" on_click = "!wlogout" }
        ]
    }

    // clickable tag buttons (label = live state from the watcher)
    $work1 = { type = "custom" name = "work1" show_if = { cmd = "~/.config/scripts/mango-ipc.py is-active 1" interval = 400 } bar = [ { type = "button" class = "work1" label = "{{watch:~/.config/scripts/mango-ipc.py tag 1}}" on_click = "!mmsg dispatch view,1,0" on_scroll_up = "!mmsg dispatch viewtoleft,0" on_scroll_down = "!mmsg dispatch viewtoright,0" } ] }
    $work2 = { type = "custom" name = "work2" show_if = { cmd = "~/.config/scripts/mango-ipc.py is-active 2" interval = 400 } bar = [ { type = "button" class = "work2" label = "{{watch:~/.config/scripts/mango-ipc.py tag 2}}" on_click = "!mmsg dispatch view,2,0" on_scroll_up = "!mmsg dispatch viewtoleft,0" on_scroll_down = "!mmsg dispatch viewtoright,0" } ] }
    $work3 = { type = "custom" name = "work3" show_if = { cmd = "~/.config/scripts/mango-ipc.py is-active 3" interval = 400 } bar = [ { type = "button" class = "work3" label = "{{watch:~/.config/scripts/mango-ipc.py tag 3}}" on_click = "!mmsg dispatch view,3,0" on_scroll_up = "!mmsg dispatch viewtoleft,0" on_scroll_down = "!mmsg dispatch viewtoright,0" } ] }
    $work4 = { type = "custom" name = "work4" show_if = { cmd = "~/.config/scripts/mango-ipc.py is-active 4" interval = 400 } bar = [ { type = "button" class = "work4" label = "{{watch:~/.config/scripts/mango-ipc.py tag 4}}" on_click = "!mmsg dispatch view,4,0" on_scroll_up = "!mmsg dispatch viewtoleft,0" on_scroll_down = "!mmsg dispatch viewtoright,0" } ] }
    $work5 = { type = "custom" name = "work5" show_if = { cmd = "~/.config/scripts/mango-ipc.py is-active 5" interval = 400 } bar = [ { type = "button" class = "work5" label = "{{watch:~/.config/scripts/mango-ipc.py tag 5}}" on_click = "!mmsg dispatch view,5,0" on_scroll_up = "!mmsg dispatch viewtoleft,0" on_scroll_down = "!mmsg dispatch viewtoright,0" } ] }
    $work6 = { type = "custom" name = "work6" show_if = { cmd = "~/.config/scripts/mango-ipc.py is-active 6" interval = 400 } bar = [ { type = "button" class = "work6" label = "{{watch:~/.config/scripts/mango-ipc.py tag 6}}" on_click = "!mmsg dispatch view,6,0" on_scroll_up = "!mmsg dispatch viewtoleft,0" on_scroll_down = "!mmsg dispatch viewtoright,0" } ] }
    $work7 = { type = "custom" name = "work7" show_if = { cmd = "~/.config/scripts/mango-ipc.py is-active 7" interval = 400 } bar = [ { type = "button" class = "work7" label = "{{watch:~/.config/scripts/mango-ipc.py tag 7}}" on_click = "!mmsg dispatch view,7,0" on_scroll_up = "!mmsg dispatch viewtoleft,0" on_scroll_down = "!mmsg dispatch viewtoright,0" } ] }
    $work8 = { type = "custom" name = "work8" show_if = { cmd = "~/.config/scripts/mango-ipc.py is-active 8" interval = 400 } bar = [ { type = "button" class = "work8" label = "{{watch:~/.config/scripts/mango-ipc.py tag 8}}" on_click = "!mmsg dispatch view,8,0" on_scroll_up = "!mmsg dispatch viewtoleft,0" on_scroll_down = "!mmsg dispatch viewtoright,0" } ] }
    $work9 = { type = "custom" name = "work9" show_if = { cmd = "~/.config/scripts/mango-ipc.py is-active 9" interval = 400 } bar = [ { type = "button" class = "work9" label = "{{watch:~/.config/scripts/mango-ipc.py tag 9}}" on_click = "!mmsg dispatch view,9,0" on_scroll_up = "!mmsg dispatch viewtoleft,0" on_scroll_down = "!mmsg dispatch viewtoright,0" } ] }

    $start = [ $music $cava $work1 $work2 $work3 $work4 $work5 $work6 $work7 $work8 $work9 ]
    $center = [ $title ]
    $end = [ $cpu $mem $disk $network $keyboard $volume $clock $tray $wlogout ]
}

in {
    name = "main"
    position = "top"
    icon_theme = "Tela-nord-dark"
    start = $start
    center = $center
    end = $end
}
