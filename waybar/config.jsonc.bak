// Waybar (top bar) for mango. Tags come from the Wayland-standard ext/workspaces
// module (mango implements ext-workspace). Window title uses scripts/mango-ipc.py
// as a custom module because this waybar was built with experimental USE off
// (so the dwl/window module is unavailable). Volume uses wireplumber (pipewire USE;
// no pulseaudio USE).
{
    "position": "top",
    "layer": "top",
    "height": 26,
    "spacing": 6,

    "modules-left": ["ext/workspaces", "custom/window"],
    "modules-center": ["clock"],
    "modules-right": ["mpd", "cpu", "memory", "disk", "network", "wireplumber", "tray"],

    "ext/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "sort-by-id": true
    },

    "custom/window": {
        "exec": "~/.config/scripts/mango-ipc.py title --max 60",
        "escape": false,
        "tooltip": false
    },

    "clock": {
        "interval": 1,
        "format": " {:%a %b %d  %H:%M}",
        "format-alt": " {:%H:%M:%S}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },

    "mpd": {
        "format": " {title}",
        "format-paused": " {title}",
        "format-stopped": "",
        "format-disconnected": "",
        "max-length": 40,
        "on-click": "mpc toggle",
        "on-scroll-up": "mpc next",
        "on-scroll-down": "mpc prev"
    },

    "cpu": {
        "format": "󰍛 {usage}%",
        "interval": 5
    },
    "memory": {
        "format": " {}%",
        "interval": 5
    },
    "disk": {
        "format": "󰋊 {percentage_used}%",
        "path": "/",
        "interval": 30
    },
    "network": {
        "format-wifi": " {essid}",
        "format-ethernet": "󰈀 {ifname}",
        "format-disconnected": "󰖪",
        "tooltip-format": "{ipaddr}",
        "on-click": "kitty --title termfloat -e nmtui"
    },
    "wireplumber": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 muted",
        "format-icons": ["", "", ""],
        "on-click": "swayosd-client --output-volume mute-toggle",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-"
    },
    "tray": {
        "icon-size": 16,
        "spacing": 8
    }
}
